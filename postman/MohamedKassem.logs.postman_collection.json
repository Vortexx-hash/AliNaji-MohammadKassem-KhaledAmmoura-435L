{
  "info": {
    "name": "Mohamed Kassem - Security Audit Logging",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run the Mohamed Kassem collections in order: Users first (it logs in and stores tokens and user ids in the environment), then Logs, then Notifications. Use MohamedKassem.environment.json and fill admin_password locally."
  },
  "variable": [
    {
      "key": "run_id",
      "value": ""
    },
    {
      "key": "today",
      "value": ""
    },
    {
      "key": "log_id",
      "value": ""
    },
    {
      "key": "idempotent_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Mohamed Kassem - Create log record",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{logs_base}}/MohamedKassem/logs",
        "description": "Administrator or service token. Users, Notifications, Threats, Vulnerabilities and Reports deliver their events here automatically. Expected HTTP 201. Author: Mohamed Kassem.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{admin_token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user_id\": {{user_id}},\n  \"action\": \"MANUAL_REVIEW\",\n  \"description\": \"Administrator reviewed the employee's access request\",\n  \"severity\": \"Information\",\n  \"related_service\": \"Security Audit Logging\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set('log_id', pm.response.json().id);"
            ]
          }
        }
      ]
    },
