    {
      "name": "Mohamed Kassem - Mark notification as read",
      "request": {
        "method": "PUT",
        "header": [],
        "url": "{{notifications_base}}/MohamedKassem/notifications/{{notification_id}}/read",
        "description": "Moves the notification from Unread to Read and records read_date. Expected HTTP 200. Author: Mohamed Kassem.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{user_token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const n = pm.response.json(); pm.test('Status Read with read date', () => { pm.expect(n.status).to.eql('Read'); pm.expect(n.read_date).to.be.a('string'); });",
              "pm.collectionVariables.set('read_date', n.read_date);"
            ]
          }
        }
      ]
    },
