# Copy values into your shell (this file is documentation, not loaded automatically).
# Generate a private key with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=security-lab
JWT_AUDIENCE=security-services
DATA_DIR=data
# Teammates supply these full URLs, INCLUDING their own full-name route prefix.
# Optional current-user endpoint: returns {id, role, account_status} for bearer token.
IDENTITY_ME_URL=
# Required for creating vulnerabilities; contains the literal {id} placeholder.
ASSET_DETAIL_URL=
# Required for reports that use these sources; each returns a complete JSON array
# or {data: [...]} (no silently truncated/paginated results).
USERS_LIST_URL=http://127.0.0.1:8001/MohamedKassem/users
ASSETS_LIST_URL=
INCIDENTS_LIST_URL=
LOGS_LIST_URL=http://127.0.0.1:8005/MohamedKassem/logs
THREATS_LIST_URL=http://127.0.0.1:8004/AliNaji/threats
VULNERABILITIES_LIST_URL=http://127.0.0.1:8007/AliNaji/vulnerabilities
# Logs service (Mohamed Kassem). Queued events remain durable until delivered.
AUDIT_POST_URL=http://127.0.0.1:8005/MohamedKassem/logs
# Generate with: python -m scripts.service_token (setup_local writes it to .env)
AUDIT_SERVICE_TOKEN=
# Notifications service (Mohamed Kassem), used by UpstreamClient.notify().
NOTIFICATION_POST_URL=http://127.0.0.1:8008/MohamedKassem/notifications
