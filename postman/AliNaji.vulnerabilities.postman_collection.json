{
  "info": {
    "name": "Ali Naji - Vulnerability Management",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run requests in order using AliNaji.environment.local.json. Each run creates its own records. Tokens come from the team's identity service; local CLI tokens only test authorization."
  },
  "variable": [
    {
      "key": "vulnerability_id",
      "value": ""
    },
    {
      "key": "critical_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Ali Naji - Create vulnerability on verified asset",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{vulnerabilities_base}}/AliNaji/vulnerabilities",
        "description": "Requires ASSET_DETAIL_URL pointing to the teammate's real Assets service and asset_id identifying an existing asset. Starts Open with null resolution_date. CVSS is a numeric value from 0 to 10; severity is explicitly assessed.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{admin_token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Lab vulnerability\",\n  \"description\": \"Lab scanner finding requiring remediation\",\n  \"cve_identifier\": \"CVE-2025-12345\",\n  \"cvss_score\": 8.1,\n  \"severity\": \"High\",\n  \"affected_asset_id\": {{asset_id}},\n  \"discovery_source\": \"Lab scanner\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set('vulnerability_id', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Ali Naji - Create critical vulnerability",
