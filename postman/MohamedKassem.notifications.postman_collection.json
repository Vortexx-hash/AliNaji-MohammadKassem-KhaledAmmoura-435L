{
  "info": {
    "name": "Mohamed Kassem - Notification and Alert Management",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run the Mohamed Kassem collections in order: Users first (it logs in and stores tokens and user ids in the environment), then Logs, then Notifications. Use MohamedKassem.environment.json and fill admin_password locally."
  },
  "variable": [
    {
      "key": "run_id",
      "value": ""
    },
    {
      "key": "today",
      "value": ""
    },
    {
      "key": "notification_id",
      "value": ""
    },
    {
      "key": "system_notification_id",
      "value": ""
    },
    {
      "key": "read_date",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Mohamed Kassem - Create security alert for employee",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{notifications_base}}/MohamedKassem/notifications",
        "description": "Administrator or service token. The recipient is verified through the Users service before the notification is stored as Unread. Expected HTTP 201. Author: Mohamed Kassem.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{admin_token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user_id\": {{user_id}},\n  \"title\": \"Suspicious login detected\",\n  \"message\": \"A login to your account from a new location was blocked.\",\n  \"notification_type\": \"Security Alert\",\n  \"severity\": \"High\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set('notification_id', pm.response.json().id);"
            ]
          }
        }
      ]
    },
