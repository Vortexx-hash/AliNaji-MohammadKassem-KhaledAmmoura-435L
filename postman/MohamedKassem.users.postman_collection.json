{
  "info": {
    "name": "Mohamed Kassem - Users and Identity Management",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run the Mohamed Kassem collections in order: Users first (it logs in and stores tokens and user ids in the environment), then Logs, then Notifications. Use MohamedKassem.environment.json and fill admin_password locally."
  },
  "variable": [
    {
      "key": "run_id",
      "value": ""
    },
    {
      "key": "today",
      "value": ""
    },
    {
      "key": "other_id",
      "value": ""
    },
    {
      "key": "other_username",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Mohamed Kassem - Login administrator",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{users_base}}/MohamedKassem/users/login",
        "description": "Verifies the administrator's username and password against the stored bcrypt hash and returns a signed JWT, saved as admin_token. The first administrator is created with scripts.create_admin. Expected HTTP 200. Author: Mohamed Kassem.",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{admin_username}}\",\n  \"password\": \"{{admin_password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code < 300) pm.environment.set('admin_token', pm.response.json().access_token);",
              "if (pm.response.code < 300) pm.environment.set('admin_id', pm.response.json().user.id);",
              "pm.test('Bearer token issued', () => pm.expect(pm.response.json().token_type).to.eql('bearer'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Mohamed Kassem - Register security analyst",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{users_base}}/MohamedKassem/users/register",
        "description": "An administrator registers a privileged account. The password is hashed before it is stored and is never returned. Expected HTTP 201. Author: Mohamed Kassem.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{admin_token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"full_name\": \"Lab Analyst\",\n  \"username\": \"analyst_{{run_id}}\",\n  \"email\": \"analyst_{{run_id}}@example.com\",\n  \"password\": \"{{test_password}}\",\n  \"department\": \"Security Operations\",\n  \"role\": \"Security Analyst\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "if (pm.response.code < 300) pm.environment.set('analyst_id', pm.response.json().id);",
              "if (pm.response.code < 300) pm.environment.set('analyst_username', pm.response.json().username);",
              "pm.test('No password data returned', () => pm.expect(pm.response.text()).not.to.include('password'));"
            ]
          }
        }
      ]
    },
