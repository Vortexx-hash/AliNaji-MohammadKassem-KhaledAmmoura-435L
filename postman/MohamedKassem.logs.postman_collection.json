    {
      "name": "Mohamed Kassem - Create log with idempotency key",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "postman-{{run_id}}"
          }
        ],
        "url": "{{logs_base}}/MohamedKassem/logs",
        "description": "Create log with idempotency key (Mohamed Kassem). Expected HTTP 201. See docs/users-logs-notifications.md for fields and errors.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{admin_token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user_id\": {{user_id}},\n  \"action\": \"EXPORT_REQUESTED\",\n  \"description\": \"Employee requested a data export\",\n  \"severity\": \"Information\",\n  \"related_service\": \"Security Audit Logging\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set('idempotent_id', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Mohamed Kassem - Replay same idempotency key",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "postman-{{run_id}}"
          }
        ],
        "url": "{{logs_base}}/MohamedKassem/logs",
        "description": "A retried delivery with the same Idempotency-Key returns the stored record instead of a duplicate. Expected HTTP 200. Author: Mohamed Kassem.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{admin_token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user_id\": {{user_id}},\n  \"action\": \"EXPORT_REQUESTED\",\n  \"description\": \"Employee requested a data export\",\n  \"severity\": \"Information\",\n  \"related_service\": \"Security Audit Logging\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Stored record returned once', () => pm.expect(Number(pm.response.json().id)).to.eql(Number(pm.collectionVariables.get('idempotent_id'))));"
            ]
          }
        }
      ]
    },
