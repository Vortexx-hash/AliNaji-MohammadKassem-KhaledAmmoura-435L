{
  "info": {
    "name": "Ali Naji - Threat Intelligence",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run requests in order using AliNaji.environment.local.json. Each run creates its own records. Tokens come from the team's identity service; local CLI tokens only test authorization."
  },
  "variable": [
    {
      "key": "threat_id",
      "value": ""
    },
    {
      "key": "domain_id",
      "value": ""
    },
    {
      "key": "run_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Ali Naji - Create attack indicator",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{threats_base}}/AliNaji/threats",
        "description": "Create attack indicator (Ali Naji). Expected HTTP 201. See docs/api.md for fields and errors.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{admin_token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"threat_type\": \"Other Indicators\",\n  \"threat_value\": \"postman-{{run_id}}\",\n  \"description\": \"Lab attack indicator; High severity selected for investigation priority\",\n  \"severity\": \"High\",\n  \"source\": \"Postman lab run\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set('threat_id', pm.response.json().id);"
            ]
          }
        }
      ]
    },
